APP_ENV=development
APP_NAME=Agent SaaS Starter
APP_URL=http://localhost:3000
LANDING_URL=http://localhost:3002
DOCS_URL=http://localhost:3003
NEXT_PUBLIC_GITHUB_URL=
API_PUBLIC_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000
AUTH_ISSUER=http://localhost:4000
MCP_PUBLIC_URL=http://localhost:4001
MCP_RESOURCE=http://localhost:4001/mcp
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_saas_starter

API_BIND=127.0.0.1:4000
MCP_BIND=127.0.0.1:4001
AUTH_PRIVATE_KEY_PATH=.local/auth-private.pem
AUTH_PUBLIC_KEY_PATH=.local/auth-public.pem
AUTH_KEY_ID=starter-dev-1
SESSION_TTL_SECONDS=2592000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_CODE_TTL_SECONDS=300
AUTH_REQUEST_TTL_SECONDS=600
HANDOFF_TTL_SECONDS=120

EMAIL_DRIVER=log
EMAIL_FROM=Agent SaaS Starter <noreply@example.com>
SMTP_URL=

# JSON object keyed by route slug. Each provider needs openid and email scopes.
# Example: {"google":{"issuer":"https://accounts.google.com","client_id":"...","client_secret":"...","scopes":["openid","profile","email"],"label":"Google"}}
OIDC_PROVIDERS_JSON={}

DCR_ENABLED=true
CIMD_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
RUST_LOG=starter_api=info,starter_mcp_server=info,tower_http=info
